# Skopiuj plik do .env i ustaw wartości dla swojego środowiska.
APP_TOKEN=zmien-na-dlugi-losowy-token

# Lokalna baza danych pacjentów (ustaw własne, silne hasło).
POSTGRES_DB=fileloader
POSTGRES_USER=fileloader
POSTGRES_PASSWORD=zmien-na-silne-haslo-postgres

# Adres hosta z serwerem NFS oraz eksport NFS, np. /srv/nfs/incoming
NFS_SERVER=192.0.2.20
NFS_EXPORT=/srv/nfs/incoming
NFS_VERSION=4.1

# Port strony na hoście oraz limit pojedynczej paczki w bajtach
WEB_PORT=8080
MAX_UPLOAD_BYTES=53687091200

# Wymaga, aby katalog docelowy był faktycznie zamontowany przez NFS.
REQUIRE_NFS=true
